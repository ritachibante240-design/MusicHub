# Copia este ficheiro para ".env" e preenche-o. O ".env" nunca vai para o
# GitHub; este exemplo vai, para saberes o que é preciso.

# --- No teu PC ---
DATABASE_URL=mysql+pymysql://UTILIZADOR:PALAVRA_PASSE@localhost:3306/NOME_DA_BASE

# --- Na nuvem (no Render estes valores vão no painel, não aqui) ---
# DATABASE_URL=mysql://avnadmin:PALAVRA_PASSE@xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# DATABASE_SSL_CA=/etc/secrets/ca.pem
# S3_BUCKET=musichub
# S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
