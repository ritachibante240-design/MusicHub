    fontSize: 11,
    marginRight: 8,
  },
  playButton: {
    width: 38,
    height: 38,
    borderRadius: 20,
    backgroundColor: "#a78bfa",
    alignItems: "center",
    justifyContent: "center",
  },
  playButtonText: {
    color: "#17131f",
    fontSize: 17,
    fontWeight: "800",
  },
  playerPanel: {
    backgroundColor: "#22212c",
    borderRadius: 18,
    padding: 14,
    marginTop: 10,
    marginBottom: 12,
  },
  nowPlaying: {
    flexDirection: "row",
    alignItems: "center",
  },
  miniCover: {
    width: 50,
