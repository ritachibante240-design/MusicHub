
import { useEffect, useState } from "react";
import {
  ActivityIndicator,
  FlatList,
  Image,
  Pressable,
  SafeAreaView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import {
  useAudioPlayer,
  useAudioPlayerStatus,
} from "expo-audio";
import { api, STORAGE_URL } from "./src/services/api";

type Song = {
  id: number;
  title: string;
  duration: number;
  audio_url: string;
  cover_url: string | null;
  artist: { id: number; name: string } | null;
  album: {
    id: number;
    title: string;
    cover_url: string | null;
  } | null;
};

function formatTime(seconds: number) {
  const safeSeconds = Math.max(0, Math.floor(seconds || 0));
  const minutes = Math.floor(safeSeconds / 60);
  const remainingSeconds = safeSeconds % 60;

  return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
}

export default function App() {
  const [songs, setSongs] = useState<Song[]>([]);
  const [currentSong, setCurrentSong] = useState<Song | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const player = useAudioPlayer(null, {
    updateInterval: 500,
  });
  const status = useAudioPlayerStatus(player);

  useEffect(() => {
    async function loadSongs() {
      try {
        const response = await api.get<Song[]>("/songs/");
        setSongs(response.data);
      } catch (err) {
        console.error("Erro ao carregar músicas:", err);
        setError("Não foi possível carregar as músicas.");
      } finally {
        setLoading(false);
      }
    }

    loadSongs();
  }, []);

  function getMediaUrl(path: string | null) {
    return path ? `${STORAGE_URL}${path}` : "";
  }

  function playSong(song: Song) {
    try {
      if (currentSong?.id === song.id) {
        if (status.playing) {
          player.pause();
        } else {
          if (status.duration > 0 && status.currentTime >= status.duration) {
            player.seekTo(0);
          }
          player.play();
        }
        return;
      }

      setCurrentSong(song);

      player.replace({
        uri: getMediaUrl(song.audio_url),
      });

      player.play();
    } catch (err) {
      console.error("Erro ao reproduzir áudio:", err);
      setError("Não foi possível reproduzir esta música.");
    }
  }

  const duration = status.duration || currentSong?.duration || 0;
  const progress =
    duration > 0
      ? Math.min(100, (status.currentTime / duration) * 100)
      : 0;

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.logo}>MusicHub</Text>
        <Text style={styles.subtitle}>
          A tua música, num só lugar.
        </Text>
      </View>

      <Text style={styles.sectionTitle}>As tuas músicas</Text>

      {loading ? (
        <ActivityIndicator size="large" color="#a78bfa" />
      ) : error ? (
        <Text style={styles.error}>{error}</Text>
      ) : (
        <FlatList
          style={styles.songList}
          data={songs}
          keyExtractor={(item) => String(item.id)}
          contentContainerStyle={styles.list}
          ListEmptyComponent={
            <Text style={styles.subtitle}>
              Ainda não existem músicas.
            </Text>
          }
          renderItem={({ item }) => {
            const selected = currentSong?.id === item.id;

            return (
              <View style={styles.song}>
                {item.cover_url ? (
                  <Image
                    source={{ uri: getMediaUrl(item.cover_url) }}
                    style={styles.cover}
                  />
                ) : (
                  <View style={[styles.cover, styles.placeholder]}>
                    <Text style={styles.placeholderText}>♪</Text>
                  </View>
                )}

                <View style={styles.songInfo}>
                  <Text style={styles.songTitle} numberOfLines={1}>
                    {item.title}
                  </Text>
                  <Text style={styles.artist} numberOfLines={1}>
                    {item.artist?.name ?? "Artista desconhecido"}
                  </Text>
                  <Text style={styles.album} numberOfLines={1}>
                    {item.album?.title ?? "Sem álbum"}
                  </Text>
                </View>

                <Text style={styles.duration}>
                  {formatTime(item.duration)}
                </Text>

                <Pressable
                  accessibilityRole="button"
                  accessibilityLabel={
                    selected && status.playing
                      ? `Pausar ${item.title}`
                      : `Reproduzir ${item.title}`
                  }
                  style={styles.playButton}
                  onPress={() => playSong(item)}
                >
                  <Text style={styles.playButtonText}>
                    {selected && status.playing ? "Ⅱ" : "▶"}
                  </Text>
                </Pressable>
              </View>
            );
          }}
        />
      )}

      {currentSong && (
        <View style={styles.playerPanel}>
          <View style={styles.nowPlaying}>
            {currentSong.cover_url ? (
              <Image
                source={{ uri: getMediaUrl(currentSong.cover_url) }}
                style={styles.miniCover}
              />
            ) : (
              <View style={[styles.miniCover, styles.placeholder]}>
                <Text style={styles.placeholderText}>♪</Text>
              </View>
            )}

            <View style={styles.nowPlayingInfo}>
              <Text style={styles.nowPlayingLabel}>A tocar agora</Text>
              <Text style={styles.nowPlayingTitle} numberOfLines={1}>
                {currentSong.title}
              </Text>
              <Text style={styles.artist} numberOfLines={1}>
                {currentSong.artist?.name ?? "Artista desconhecido"}
              </Text>
            </View>

            <Pressable
              accessibilityRole="button"
              accessibilityLabel={status.playing ? "Pausar" : "Reproduzir"}
              style={styles.mainPlayButton}
              onPress={() => playSong(currentSong)}
            >
              <Text style={styles.mainPlayButtonText}>
                {status.playing ? "Ⅱ" : "▶"}
              </Text>
            </Pressable>
          </View>

          <View style={styles.progressTrack}>
            <View
              style={[styles.progressFill, { width: `${progress}%` }]}
            />
          </View>

          <View style={styles.timeRow}>
            <Text style={styles.timeText}>
              {formatTime(status.currentTime)}
            </Text>
            <Text style={styles.timeText}>
              {formatTime(duration)}
            </Text>
          </View>

          {status.error ? (
            <Text style={styles.error}>
              Erro de reprodução: {status.error}
            </Text>
          ) : null}
        </View>
      )}
    </SafeAreaView>
  );
}

